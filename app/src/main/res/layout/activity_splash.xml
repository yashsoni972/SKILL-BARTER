<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- Top-right decorative orb -->
    <View
        android:id="@+id/orbTopRight"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-70dp"
        android:layout_marginEnd="-70dp"
        android:alpha="0.55"
        android:background="@drawable/bg_splash_orb_large" />

    <!-- Bottom-left decorative orb -->
    <View
        android:id="@+id/orbBottomLeft"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-50dp"
        android:layout_marginBottom="-50dp"
        android:alpha="0.45"
        android:background="@drawable/bg_splash_orb_small" />

    <!-- Mid-right tiny accent dot -->
    <View
        android:id="@+id/orbMidRight"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="20dp"
        android:alpha="0.2"
        android:background="@drawable/bg_splash_orb_large" />

    <!-- Center content -->
    <LinearLayout
        android:id="@+id/layoutSplashContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Logo + pulse ring wrapper -->
        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center">

            <!-- Outer pulse ring (animated via code) -->
            <View
                android:id="@+id/viewPulseOuter"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_logo_pulse_ring" />

            <!-- Inner pulse ring -->
            <View
                android:id="@+id/viewPulseInner"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_logo_pulse_ring" />

            <!-- The logo -->
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:contentDescription="SkillBarter Logo"
                android:src="@drawable/ic_logo" />

        </FrameLayout>

        <!-- App name with letter-spacing -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="SkillBarter"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Gradient underline accent bar -->
        <View
            android:layout_width="50dp"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hero_banner" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvAppTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.03"
            android:text="Exchange Skills, Not Money"
            android:textColor="#B8C5E0"
            android:textSize="15sp" />

        <!-- Feature pills row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1A6C63FF"
                android:drawablePadding="5dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="🤝 Barter"
                android:textColor="#A78BFA"
                android:textSize="12sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1A00BFA5"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="🤖 AI Roadmap"
                android:textColor="#6EE7B7"
                android:textSize="12sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1AFCD34D"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="💬 Chat"
                android:textColor="#FCD34D"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom CTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingBottom="40dp">

        <Button
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_get_started_button"
            android:text="Get Started →"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:text="Peer-to-peer skill exchange platform"
            android:textColor="#5A7093"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
